---
import Base from '~/layouts/Base.astro';
import SectionHeader from '~/components/SectionHeader.astro';
import BacktestCard from '~/components/BacktestCard.astro';
import { BACKTESTS } from '~/data/content';

const totalAssets = BACKTESTS.reduce((sum, b) => sum + b.assets, 0);
---
<Base
  title="Backtest Centre"
  description="Hermes backtest artefacts from the Austin Trading Engine. Diagnostics, not strategy backtests. No broker. No paper-trading. No order placement."
>
  <section class="page-hero">
    <div class="bg-aurora"></div>
    <div class="container page-hero__inner">
      <span class="eyebrow">Backtest Centre · diagnostic artefacts</span>
      <h1>Hermes validation runs.</h1>
      <p class="lede">
        Every run here is a Hermes diagnostic validation — multi-asset, hypothesis-locked, YAML-free, reproducible from the manifest. None are strategy backtests; none produce trade signals.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Coverage"
        title="Five complete diagnostic validations."
        lede="These are the runs that produced the current engine classifications — not synthetic placeholder data."
      />

      <div class="grid cols-4 stat-grid">
        <div class="stat-card card">
          <span class="value mono">{BACKTESTS.length}</span>
          <span class="label">validation runs</span>
        </div>
        <div class="stat-card card">
          <span class="value mono">{totalAssets}</span>
          <span class="label">unique assets tested (sum)</span>
        </div>
        <div class="stat-card card">
          <span class="value mono">3</span>
          <span class="label">currencies · 2 precious metals</span>
        </div>
        <div class="stat-card card">
          <span class="value mono">Yahoo</span>
          <span class="label">public OHLC source</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        eyebrow="Artefacts"
        title="Each run: a directory of CSVs, a manifest, charts, a Python runner."
      />
      <div class="grid cols-2">
        {BACKTESTS.map((b) => <BacktestCard bt={b} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Storage layout"
        title="backtests/Hermes/&lt;release&gt;/&lt;cadence&gt;/Diagnostic_Validation/&lt;RDR&gt;/"
      />
      <pre class="bash mono small">backtests/Hermes/
├── ATE_v2.1/Daily/Diagnostic_Validation/RDR-002/        # VolatilityEngine · 14 assets
├── ATE_v2.1/Weekly/Diagnostic_Validation/RDR-002W/      # VolatilityEngine · 15 assets
├── ATE_v2.2/Daily/Diagnostic_Validation/RDR-003/        # RiskEngine     · 16 assets
├── ATE_v2.2/Weekly/Diagnostic_Validation/RDR-003W/      # RiskEngine     · 16 assets
└── ATE_v2.2/Diagnostic_Validation/RDR-010/              # TrendEngine dev mirror · Gold/Silver/Gilts</pre>
    </div>
  </section>
</Base>

<style>
  .page-hero { position: relative; overflow: hidden;
    padding-block: clamp(72px, 9vw, 120px) clamp(36px, 5vw, 64px);
    border-bottom: 1px solid var(--line-1);
  }
  .page-hero__inner { max-width: 820px; }
  .page-hero h1 { margin-bottom: 16px; }

  .section--alt {
    background: linear-gradient(180deg, transparent, rgba(200, 164, 90, 0.018), transparent);
    border-block: 1px solid var(--line-1);
  }
  .stat-grid .stat-card { background: var(--bg-1); text-align: center; }
  .stat-grid .stat-card .value { font-size: 1.8rem; display: block; margin-bottom: 4px; }
  .stat-grid .stat-card .label {
    font-size: 0.74rem; color: var(--ink-3);
    text-transform: uppercase; letter-spacing: 0.08em;
    font-family: var(--font-mono);
  }
  pre.bash {
    background: var(--bg-1) !important;
    border: 1px solid var(--line-1);
    border-radius: var(--radius);
    padding: 18px 22px;
    font-size: 13px;
    line-height: 1.7;
    overflow-x: auto;
    white-space: pre;
  }
  @media (max-width: 980px) {
    .stat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
