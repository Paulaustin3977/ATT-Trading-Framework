---
import Base from '~/layouts/Base.astro';
import SectionHeader from '~/components/SectionHeader.astro';
import Pill from '~/components/Pill.astro';
import { VERIFIER, RDRS } from '~/data/content';
---
<Base
  title="Validation & Evidence"
  description="Deterministic verification · regression tests · Research Decision Records · reproducibility · immutable releases. The evidence-first methodology, end to end."
>
  <section class="page-hero">
    <div class="bg-aurora"></div>
    <div class="container page-hero__inner">
      <span class="eyebrow">Validation · evidence · reproducibility</span>
      <h1>Evidence before claims.</h1>
      <p class="lede">
        Every claim ATE makes is either (a) verified by the canonical verifier, (b) supported by an RDR, or (c) explicitly labelled as a hypothesis. We do not invent classifications.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Canonical verifier"
        title="One gate. 442 checks. Every release."
        lede="The verifier runs as part of CI on every push. It enforces contract, boundary, fixture, and integrity checks against the immutable Pine release."
      />

      <div class="grid cols-4 verifier-grid">
        <div class="stat-card card">
          <span class="value mono">{VERIFIER.totalChecks}</span>
          <span class="label">total checks</span>
        </div>
        <div class="stat-card card">
          <span class="value mono green">{VERIFIER.passed}</span>
          <span class="label">passed</span>
        </div>
        <div class="stat-card card">
          <span class="value mono green">0</span>
          <span class="label">failed</span>
        </div>
        <div class="stat-card card">
          <span class="value mono green">Yes</span>
          <span class="label">v2.2 SHA matches manifest</span>
        </div>
      </div>

      <div class="card verifier-cmd">
        <span class="verifier-cmd__label mono">$</span>
        <code>{VERIFIER.command}</code>
        <pre class="bash">
{`total_checks   = ${VERIFIER.totalChecks}
passed         = ${VERIFIER.passed}
failed         = ${VERIFIER.failed}
exit           = 0
v22 release SHA matches manifest: ${VERIFIER.v22ReleaseShaMatches ? 'True' : 'False'}
v22 release == dev byte-identical: ${VERIFIER.v22DevByteIdentical ? 'True' : 'False'}
v21 SHA unchanged:                ${VERIFIER.v21ShaUnchanged ? 'True' : 'False'}`}</pre>
      </div>

      <p class="mono small notes">{VERIFIER.notes.join(' · ')}</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        eyebrow="Determinism"
        title="Reproducibility is non-negotiable."
        lede="Hermes runs are reproducible from the commit hash they reference. Outputs are never edited by hand — re-run instead."
      />
      <div class="grid cols-3">
        <div class="card hover">
          <h3>Reproducible inputs</h3>
          <p>OHLC raw cache is not committed under the RDR-001 raw-data policy, but committed reproduction scripts can re-download via <code>yfinance</code> for any supported yfinance ticker.</p>
        </div>
        <div class="card hover">
          <h3>Deterministic harness</h3>
          <p>Python mirrors of each engine compute path — only the official <code>ta.*</code> Pine v6 namespaces are translated. No platform-specific non-determinism.</p>
        </div>
        <div class="card hover">
          <h3>No hand-edited outputs</h3>
          <p>If a run disagrees with the hypothesis, the run is re-executed — never the CSV.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Research Decision Records"
        title="Validation lifecycle, end to end."
        lede="RDRs are hypothesis-driven exercises. They cover daily bars, weekly bars, or both. Negative results are recorded as findings."
      />
      <table class="table">
        <thead>
          <tr><th>ID</th><th>Engine</th><th>Cadence</th><th>Assets</th><th>Span</th><th>Classification</th></tr>
        </thead>
        <tbody>
          {RDRS.map((r) => (
            <tr>
              <td class="mono"><a href="/research">{r.id}</a></td>
              <td>{r.engine}</td>
              <td>{r.timeframe}</td>
              <td class="mono">{r.assets}</td>
              <td class="mono small">{r.file.replace('research/Reports/RDR/','')}</td>
              <td>
                <Pill variant={r.classification === 'Supported' ? 'green' : r.classification === 'Weakly Supported' ? 'amber' : r.classification === 'Mixed' ? 'amber' : 'gray'}>
                  {r.classification}
                </Pill>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        eyebrow="Research classification"
        title="Five classifications. Same vocabulary across every RDR."
        lede="We use one set of words across all five RDRs — no engine-level labels, no per-record re-definitions."
      />
      <div class="grid cols-3">
        <div class="card hover"><Pill variant="green">Supported</Pill><p>Diagnostic behaviour empirically consistent with the spec; recommendation may still say "Keep Diagnostic".</p></div>
        <div class="card hover"><Pill variant="amber">Weakly Supported</Pill><p>Signal present but thresholds or sample thickness warrant repeated observation.</p></div>
        <div class="card hover"><Pill variant="amber">Mixed</Pill><p>Heterogeneous evidence by instrument, horizon, or timeframe. Research-only.</p></div>
        <div class="card hover"><Pill variant="red">Unsupported</Pill><p>Hypothesis not supported by evidence. Finding, not failure.</p></div>
        <div class="card hover"><Pill variant="gray">Pending</Pill><p>Run incomplete or under analysis — never used to back a downstream claim.</p></div>
        <div class="card hover"><Pill variant="gold">Approved</Pill><p>Scope authorised by Paul Austin. Diagnostic/research approval does not imply action authority.</p></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-hero { position: relative; overflow: hidden;
    padding-block: clamp(72px, 9vw, 120px) clamp(36px, 5vw, 64px);
    border-bottom: 1px solid var(--line-1);
  }
  .page-hero__inner { max-width: 820px; }
  .page-hero h1 { margin-bottom: 16px; }

  .section--alt {
    background: linear-gradient(180deg, transparent, rgba(200, 164, 90, 0.018), transparent);
    border-block: 1px solid var(--line-1);
  }

  .verifier-grid .stat-card { background: var(--bg-1); text-align: center; }
  .verifier-grid .stat-card .value { font-size: 2rem; display: block; margin-bottom: 4px; font-family: var(--font-mono); }
  .verifier-grid .stat-card .value.green { color: var(--bull); }
  .verifier-grid .stat-card .label {
    font-size: 0.74rem; color: var(--ink-3);
    text-transform: uppercase; letter-spacing: 0.08em;
    font-family: var(--font-mono);
  }

  .verifier-cmd {
    margin-top: 24px;
    padding: 18px;
    display: grid;
    grid-template-columns: 24px auto 1fr;
    gap: 12px;
    align-items: start;
    background: var(--bg-1);
  }
  .verifier-cmd__label { color: var(--gold-1); padding-top: 4px; }
  .verifier-cmd code { background: transparent; border: 0; padding: 4px 0; color: var(--ink-1); font-size: 0.86rem; }
  .verifier-cmd pre.bash {
    grid-column: 1 / -1; margin: 8px 0 0;
    background: var(--bg-3) !important;
    border: 1px solid var(--line-1); border-radius: 8px;
    padding: 12px 14px; font-size: 0.78rem;
  }

  .notes { margin-top: 14px; color: var(--ink-3); }

  @media (max-width: 980px) {
    .verifier-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
