---
import Pill from './Pill.astro';
import { classificationColor } from '~/data/content';
export interface Props {
  rdr: {
    id: string;
    title: string;
    engine: string;
    assetClass: string;
    timeframe: string;
    assets: number;
    date: string;
    classification: string;
    recommendation: string;
    file: string;
    companion?: string | null;
  };
  compact?: boolean;
}
const { rdr, compact = false } = Astro.props;
const variant = classificationColor(rdr.classification);
---
<article class={`rdr-card card ${compact ? 'compact' : ''}`}>
  <header class="rdr-card__head">
    <div>
      <span class="rdr-card__id mono">{rdr.id}</span>
      <h3>{rdr.title}</h3>
    </div>
    <Pill variant={variant}>{rdr.classification}</Pill>
  </header>

  <dl class="rdr-card__grid">
    <div>
      <dt>Engine</dt>
      <dd>{rdr.engine}</dd>
    </div>
    <div>
      <dt>Timeframe</dt>
      <dd>{rdr.timeframe}</dd>
    </div>
    <div>
      <dt>Assets</dt>
      <dd>{rdr.assets}</dd>
    </div>
    <div>
      <dt>Date</dt>
      <dd>{rdr.date}</dd>
    </div>
  </dl>

  <p class="rdr-card__class">{rdr.assetClass}</p>

  <p class="rdr-card__rec">
    <strong>Recommendation.</strong> {rdr.recommendation}
  </p>

  <footer class="rdr-card__foot">
    <a class="btn small ghost" href={`https://raw.githubusercontent.com/Paulaustin3977/ATT-Trading-Framework/main/${rdr.file}`} target="_blank" rel="noopener">
      Read full report →
    </a>
    {rdr.companion && (
      <span class="rdr-card__companion mono">Companion: {rdr.companion}</span>
    )}
  </footer>
</article>

<style>
  .rdr-card { display: flex; flex-direction: column; gap: 14px; }
  .rdr-card__head {
    display: flex; justify-content: space-between; align-items: flex-start; gap: 16px;
  }
  .rdr-card__id {
    color: var(--gold-1); font-size: 0.78rem; letter-spacing: 0.06em;
    display: block; margin-bottom: 4px;
  }
  .rdr-card__head h3 { font-size: 1rem; line-height: 1.3; }
  .rdr-card__grid {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px; margin: 0; padding: 12px;
    background: var(--bg-2); border: 1px solid var(--line-1); border-radius: 8px;
  }
  .rdr-card__grid dt {
    font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--ink-3); font-family: var(--font-mono); margin-bottom: 4px;
  }
  .rdr-card__grid dd { font-size: 0.86rem; color: var(--ink-1); margin: 0; font-weight: 500; }
  .rdr-card__class { font-size: 0.84rem; color: var(--ink-2); margin: 0; line-height: 1.6; }
  .rdr-card__rec { font-size: 0.88rem; color: var(--ink-2); margin: 0; line-height: 1.55; }
  .rdr-card__rec strong { color: var(--ink-1); font-weight: 600; }
  .rdr-card__foot {
    display: flex; justify-content: space-between; align-items: center;
    border-top: 1px solid var(--line-1); padding-top: 12px; gap: 12px; flex-wrap: wrap;
  }
  .rdr-card__companion { font-size: 0.74rem; color: var(--ink-3); }
  .compact .rdr-card__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
</style>
