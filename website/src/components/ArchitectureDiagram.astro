---
/**
 * Architecture diagram — exact engine map rendered from docs/Architecture.md.
 * Eight engines in three layers: Evidence → Confidence → Risk → Decision → Dashboard.
 */
---
<div class="arch-diagram" aria-label="Austin Trading Engine architecture diagram">
  <svg viewBox="0 0 900 540" width="100%" preserveAspectRatio="xMidYMid meet" role="img">
    <defs>
      <linearGradient id="layer-evidence" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#1a2235"/>
        <stop offset="100%" stop-color="#0e1320"/>
      </linearGradient>
      <linearGradient id="layer-aggregator" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#1f1620"/>
        <stop offset="100%" stop-color="#160e1a"/>
      </linearGradient>
      <linearGradient id="layer-decision" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#261c0d"/>
        <stop offset="100%" stop-color="#1a1308"/>
      </linearGradient>
      <linearGradient id="layer-presentation" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#0e1a1f"/>
        <stop offset="100%" stop-color="#0a1216"/>
      </linearGradient>
      <linearGradient id="gold-stroke" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#c8a45a" stop-opacity="0.0"/>
        <stop offset="50%" stop-color="#c8a45a" stop-opacity="1"/>
        <stop offset="100%" stop-color="#c8a45a" stop-opacity="0.0"/>
      </linearGradient>
      <marker id="arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 z" fill="#c8a45a"/>
      </marker>
      <marker id="arrow-deferred" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 z" fill="#5a6478"/>
      </marker>
    </defs>

    <rect x="0" y="0" width="900" height="540" fill="#07090d"/>

    <!-- Title -->
    <text x="40" y="40" fill="#f4f6fb" font-family="Inter, sans-serif" font-weight="700" font-size="18" letter-spacing="-0.02em">
      Austin Trading Engine · Engine Map
    </text>
    <text x="40" y="62" fill="#8c96aa" font-family="Inter, sans-serif" font-size="12">
      Independent engines · one-way data flow · bar-close only · Engine Output Contract
    </text>

    <!-- Evidence layer (4 analytical engines) -->
    <rect x="40" y="92" width="820" height="92" fill="url(#layer-evidence)" stroke="#1a2235" stroke-width="1" rx="10"/>
    <text x="58" y="112" fill="#8c96aa" font-family="JetBrains Mono, monospace" font-size="10" letter-spacing="0.1em">
      EVIDENCE LAYER  ·  ANALYTICAL READS
    </text>

    <!-- 4 boxes -->
    <g font-family="Inter, sans-serif" font-size="13" fill="#f4f6fb">
      <rect x="58"  y="124" width="190" height="48" fill="#111723" stroke="#2c3548" rx="8"/>
      <text x="68"  y="146" font-weight="600">TrendEngine</text>
      <text x="68"  y="162" fill="#8c96aa" font-size="10">direction &amp; persistence</text>

      <rect x="262" y="124" width="190" height="48" fill="#111723" stroke="#2c3548" rx="8"/>
      <text x="272" y="146" font-weight="600">StructureEngine</text>
      <text x="272" y="162" fill="#8c96aa" font-size="10">highs · lows · breakouts</text>

      <rect x="466" y="124" width="190" height="48" fill="#111723" stroke="#2c3548" rx="8"/>
      <text x="476" y="146" font-weight="600">MomentumEngine</text>
      <text x="476" y="162" fill="#8c96aa" font-size="10">rate-of-change · persistence</text>

      <rect x="670" y="124" width="172" height="48" fill="#111723" stroke="#2c3548" rx="8"/>
      <text x="680" y="146" font-weight="600">VolatilityEngine</text>
      <text x="680" y="162" fill="#8c96aa" font-size="10">regimes · v1.0.0-draft</text>
    </g>

    <!-- ConfidenceLayer -->
    <rect x="40" y="208" width="820" height="78" fill="url(#layer-aggregator)" stroke="#2a1f30" rx="10"/>
    <text x="58" y="228" fill="#8c96aa" font-family="JetBrains Mono, monospace" font-size="10" letter-spacing="0.1em">
      AGGREGATION LAYER  ·  CONFIDENCE
    </text>
    <rect x="58" y="240" width="784" height="36" fill="#1a1422" stroke="#3a2840" rx="8"/>
    <text x="80" y="263" font-family="Inter, sans-serif" font-size="13" fill="#f4f6fb" font-weight="600">
      ConfidenceEngine
    </text>
    <text x="280" y="263" font-family="Inter, sans-serif" font-size="11" fill="#8c96aa">
      strength of evidence · trend + structure + momentum inputs (v2.2) · no Vol or Risk input
    </text>

    <!-- Risk Layer -->
    <rect x="40" y="310" width="820" height="78" fill="url(#layer-decision)" stroke="#3a2a16" rx="10"/>
    <text x="58" y="330" fill="#8c96aa" font-family="JetBrains Mono, monospace" font-size="10" letter-spacing="0.1em">
      SAFETY LAYER  ·  RISK
    </text>
    <rect x="58" y="342" width="784" height="36" fill="#1a1410" stroke="#4a3525" rx="8"/>
    <text x="80" y="365" font-family="Inter, sans-serif" font-size="13" fill="#f4f6fb" font-weight="600">
      RiskEngine <tspan fill="#8c96aa" font-weight="500" font-size="11"> · v1.0.0-draft · diagnostic-only · no riskApproved</tspan>
    </text>

    <!-- DecisionEngine — deferred (greyed out) -->
    <rect x="40" y="412" width="820" height="60" fill="#0c1018" stroke="#2a2f3a" stroke-dasharray="6 5" rx="10"/>
    <text x="58" y="432" fill="#5a6478" font-family="JetBrains Mono, monospace" font-size="10" letter-spacing="0.1em">
      ACTION LAYER  ·  DEFERRED
    </text>
    <text x="80" y="455" font-family="Inter, sans-serif" font-size="13" fill="#5a6478" font-weight="600">
      DecisionEngine
    </text>
    <text x="246" y="455" font-family="Inter, sans-serif" font-size="11" fill="#5a6478">
      out of current research-only scope · no action authority · not implemented
    </text>

    <!-- Dashboard presentation -->
    <rect x="40" y="494" width="820" height="36" fill="url(#layer-presentation)" stroke="#1a2a32" rx="10"/>
    <text x="80" y="517" font-family="Inter, sans-serif" font-size="12" fill="#c8d0df" font-weight="600">
      DashboardEngine · Research Mode · 10 preserved alertcondition titles
    </text>
    <text x="540" y="517" font-family="Inter, sans-serif" font-size="11" fill="#8c96aa">
      presentation only · no engine value mutation
    </text>

    <!-- Arrows -->
    <line x1="450" y1="172" x2="450" y2="206" stroke="#c8a45a" stroke-width="1.4" marker-end="url(#arrow)"/>
    <text x="460" y="194" fill="#8c96aa" font-family="JetBrains Mono, monospace" font-size="9">outputs</text>

    <line x1="450" y1="276" x2="450" y2="308" stroke="#c8a45a" stroke-width="1.4" marker-end="url(#arrow)"/>
    <line x1="450" y1="378" x2="450" y2="410" stroke="#5a6478" stroke-width="1.2" stroke-dasharray="4 4" marker-end="url(#arrow-deferred)"/>
    <line x1="450" y1="472" x2="450" y2="492" stroke="#c8a45a" stroke-width="1.4" marker-end="url(#arrow)"/>
  </svg>
</div>

<div class="arch-diagram__legend">
  <span><span class="arch-line solid"></span> Active data flow</span>
  <span><span class="arch-line dashed"></span> Deferred / out-of-scope</span>
  <span><span class="arch-line gold"></span> Engine Output Contract · bar-close only</span>
</div>

<style>
  .arch-diagram {
    background: var(--bg-2);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-lg);
    padding: 18px;
    overflow: hidden;
  }
  .arch-diagram svg { display: block; }
  .arch-diagram__legend {
    margin-top: 12px;
    display: flex; gap: 18px; flex-wrap: wrap;
    font-size: 0.78rem; color: var(--ink-3);
  }
  .arch-diagram__legend span { display: inline-flex; align-items: center; gap: 8px; }
  .arch-line { width: 24px; height: 2px; background: var(--gold-1); display: inline-block; border-radius: 2px; }
  .arch-line.dashed { background: transparent; border-top: 2px dashed var(--ink-4); }
  .arch-line.gold { background: linear-gradient(90deg, transparent, var(--gold-1), transparent); }
</style>
