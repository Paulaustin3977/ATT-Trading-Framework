---
/**
 * ATE v2.2 illustrative dashboard mock.
 *
 * NOTE: All numbers shown are illustrative — they demonstrate the diagnostic
 * six-state / five-direction model from spec/architecture. They are not real
 * market data and not real ATE performance. The diagnostic-band labels and
 * component caps (vol 35 / ext 30 / struct 20 / conflict 15) are exact from
 * `specifications/ATE/RiskEngine.md` and `docs/releases/ATE_v2.2_Release_Manifest.md`.
 */
---
<div class="dash" aria-label="Illustrative ATE v2.2 dashboard preview">
  <div class="dash__notice">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
      <path d="M12 8v5M12 16h.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
    <span>Illustrative preview · values shown are diagnostic-concept demonstrations, not real market data</span>
  </div>

  <div class="dash__layout">
    <!-- LEFT: Engine stack -->
    <section class="dash__panel">
      <header class="dash__panel-head">
        <span class="dash__panel-title">Engine Stack</span>
        <span class="dash__panel-meta mono">v2.2 · bar-close</span>
      </header>

      <!-- TrendEngine -->
      <div class="dash__row">
        <span class="dash__row-name">TrendEngine</span>
        <span class="dash__row-state"><span class="dot green"></span>Bullish</span>
        <span class="dash__row-score mono">62.4</span>
      </div>
      <!-- StructureEngine -->
      <div class="dash__row">
        <span class="dash__row-name">StructureEngine</span>
        <span class="dash__row-state"><span class="dot green"></span>Trending</span>
        <span class="dash__row-score mono">68.1</span>
      </div>
      <!-- MomentumEngine -->
      <div class="dash__row">
        <span class="dash__row-name">MomentumEngine</span>
        <span class="dash__row-state"><span class="dot green"></span>Bullish</span>
        <span class="dash__row-score mono">57.9</span>
      </div>
      <!-- VolatilityEngine -->
      <div class="dash__row">
        <span class="dash__row-name">VolatilityEngine</span>
        <span class="dash__row-state"><span class="dot amber"></span>Expanding</span>
        <span class="dash__row-score mono">54.0</span>
      </div>
      <!-- ConfidenceEngine -->
      <div class="dash__row dash__row--accent">
        <span class="dash__row-name">ConfidenceEngine</span>
        <span class="dash__row-state"><span class="dot green"></span>High</span>
        <span class="dash__row-score mono">71.3</span>
      </div>
    </section>

    <!-- MIDDLE: RiskEngine diagnostic only -->
    <section class="dash__panel">
      <header class="dash__panel-head">
        <span class="dash__panel-title">RiskEngine · diagnostic-only</span>
        <span class="dash__panel-meta mono">no riskApproved</span>
      </header>

      <div class="risk-bands" role="list">
        <span class="risk-band r-calm" role="listitem">calm</span>
        <span class="risk-band r-normal" role="listitem">normal</span>
        <span class="risk-band r-elevated active" role="listitem">elevated</span>
        <span class="risk-band r-tense" role="listitem">tense</span>
        <span class="risk-band r-extreme" role="listitem">extreme</span>
        <span class="risk-band r-unknown" role="listitem">unknown</span>
      </div>

      <div class="risk-bar" aria-hidden="true">
        <span style="left: 38%; width: 18%; background: var(--risk-elevated);"></span>
        <span class="marker" style="left: 47%;"></span>
        <span class="zero"  style="left: 0;"></span>
        <span class="hundred" style="left: 100%;"></span>
      </div>

      <dl class="components">
        <div><dt>Volatility 0–35</dt><dd class="mono">18 / 35</dd></div>
        <div><dt>Extension 0–30</dt><dd class="mono">22 / 30</dd></div>
        <div><dt>Structure 0–20</dt><dd class="mono">14 / 20</dd></div>
        <div><dt>Conflict 0–15</dt><dd class="mono">6  / 15</dd></div>
        <div class="risk-total"><dt>Total (clamped 0–100)</dt><dd class="mono">60.0</dd></div>
      </dl>
    </section>

    <!-- RIGHT: Research Mode -->
    <section class="dash__panel">
      <header class="dash__panel-head">
        <span class="dash__panel-title">Research Mode</span>
        <span class="dash__panel-meta mono">per-bar panel</span>
      </header>

      <pre class="research-mode mono" aria-label="Illustrative Research Mode output">ATE v2.2 · diagnostic-only
─────────────────────────────
Trend       : Bullish       62.4
Structure   : Trending      68.1
Momentum    : Bullish       57.9
Volatility  : Expanding     54.0   (diagnostic)
Confidence  : High          71.3
Risk        : Elevated      60.0   (diagnostic)
  · vol=18/35 · ext=22/30
  · struct=14/20 · conflict=6/15
Direction   : none (no action)
─────────────────────────────
No broker. No orders. No positions.
Reserved language audited clean.</pre>
    </section>
  </div>
</div>

<style>
  .dash {
    background: var(--bg-1);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-lg);
    padding: 16px;
  }
  .dash__notice {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 0.74rem; color: var(--ink-3);
    background: rgba(217, 166, 74, 0.06);
    border: 1px dashed rgba(217, 166, 74, 0.25);
    padding: 6px 10px; border-radius: 999px;
    margin-bottom: 14px;
    font-family: var(--font-mono);
  }
  .dash__notice svg { color: #d9a64a; }

  .dash__layout {
    display: grid;
    grid-template-columns: 1.1fr 1.2fr 1.1fr;
    gap: 14px;
  }
  .dash__panel {
    background: var(--bg-2);
    border: 1px solid var(--line-1);
    border-radius: 12px;
    padding: 14px;
  }
  .dash__panel-head {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line-1);
  }
  .dash__panel-title {
    font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--ink-3); font-family: var(--font-mono); font-weight: 600;
  }
  .dash__panel-meta { font-size: 0.7rem; color: var(--ink-3); }

  .dash__row {
    display: grid; grid-template-columns: 1fr auto 56px;
    gap: 10px; align-items: center;
    padding: 6px 8px; border-radius: 8px;
  }
  .dash__row + .dash__row { margin-top: 4px; }
  .dash__row:hover { background: rgba(255, 255, 255, 0.02); }
  .dash__row--accent { background: rgba(200, 164, 90, 0.05); border: 1px solid rgba(200, 164, 90, 0.15); border-radius: 8px; padding: 8px; }
  .dash__row-name { font-size: 0.8rem; color: var(--ink-2); font-weight: 500; }
  .dash__row-state { font-size: 0.74rem; color: var(--ink-3); display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); }
  .dash__row-score { font-size: 0.84rem; color: var(--ink-1); font-weight: 500; text-align: right; }

  .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .dot.green { background: var(--bull); box-shadow: 0 0 8px rgba(62, 194, 143, 0.5); }
  .dot.amber { background: #d9a64a; box-shadow: 0 0 8px rgba(217, 166, 74, 0.5); }
  .dot.red   { background: var(--bear); box-shadow: 0 0 8px rgba(240, 100, 100, 0.5); }

  .risk-bands {
    display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 14px;
  }
  .risk-band {
    font-family: var(--font-mono); font-size: 0.7rem;
    padding: 4px 8px; border-radius: 999px;
    border: 1px solid var(--line-2);
    color: var(--ink-3);
    background: rgba(255, 255, 255, 0.02);
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  .risk-band.r-calm     { border-color: rgba(107, 156, 255, 0.28); color: #8fb6ff; }
  .risk-band.r-normal   { border-color: rgba(62, 194, 143, 0.28); color: var(--bull); }
  .risk-band.r-elevated { border-color: rgba(217, 166, 74, 0.28); color: #e3b46a; }
  .risk-band.r-tense    { border-color: rgba(232, 134, 90, 0.28); color: #e8865a; }
  .risk-band.r-extreme  { border-color: rgba(240, 100, 100, 0.28); color: var(--bear); }
  .risk-band.r-unknown  { border-color: var(--line-2); color: var(--ink-3); }
  .risk-band.active     { box-shadow: 0 0 0 1px currentColor; }

  .risk-bar {
    position: relative;
    height: 8px;
    background: var(--bg-3);
    border-radius: 999px;
    margin-bottom: 16px;
    border: 1px solid var(--line-2);
  }
  .risk-bar > span:not(.marker):not(.zero):not(.hundred) {
    position: absolute; top: 0; bottom: 0; border-radius: 999px;
    box-shadow: 0 0 14px currentColor;
  }
  .risk-bar .marker {
    position: absolute; top: -3px; bottom: -3px;
    width: 2px; background: var(--gold-1); box-shadow: 0 0 8px var(--gold-1);
  }
  .risk-bar .zero, .risk-bar .hundred {
    position: absolute; top: -4px; width: 1px; height: 16px; background: var(--ink-4);
  }

  .components {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 12px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .components dt { color: var(--ink-3); }
  .components dd { color: var(--ink-1); margin: 0; text-align: right; }
  .components > div { display: contents; }
  .risk-total {
    display: flex !important; justify-content: space-between;
    margin-top: 8px; padding-top: 8px;
    border-top: 1px dashed var(--line-2);
  }
  .risk-total dt { color: var(--gold-1) !important; font-weight: 600; }

  .research-mode {
    margin: 0;
    background: var(--bg-3) !important;
    border: 1px solid var(--line-1);
    border-radius: 8px;
    padding: 14px;
    font-size: 0.74rem;
    color: var(--ink-2);
    line-height: 1.65;
    white-space: pre-wrap;
  }

  @media (max-width: 980px) {
    .dash__layout { grid-template-columns: 1fr; }
  }
</style>
