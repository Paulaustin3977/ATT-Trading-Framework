---
import { SITE, REPO, NAV } from '~/data/content';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label={`${SITE.organisation} home`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="28" height="28" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="g1" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#d8b56a"/>
              <stop offset="100%" stop-color="#876f3f"/>
            </linearGradient>
          </defs>
          <path fill="url(#g1)" d="M16 2 L29 9 V23 L16 30 L3 23 V9 Z"/>
          <path fill="#0b0f17" d="M16 6 L25 11 V21 L16 26 L7 21 V11 Z"/>
          <path fill="url(#g1)" d="M11 19 L13.5 13.5 L16 18 L18.5 11 L21 19 Z"/>
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-text__name">Austin Trading Team</span>
        <span class="brand-text__sub">{SITE.productAbbr} · Market Diagnostics</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <button class="site-nav__toggle" aria-expanded="false" aria-controls="nav-list">
        <span class="sr-only">Toggle navigation</span>
        <span aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </span>
      </button>
      <ul id="nav-list" class="site-nav__list">
        {NAV.map((item) => {
          const norm = item.href.replace(/\/$/, '') || '/';
          const active = norm === path || (norm !== '/' && path.startsWith(norm));
          return (
            <li><a href={item.href} class={active ? 'active' : undefined}>{item.label}</a></li>
          );
        })}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="btn small ghost" href={REPO.url} target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.3 1.9 1.3 1.1 1.8 2.9 1.3 3.6 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.3 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/>
        </svg>
        GitHub
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(160%) blur(12px);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
    background: rgba(7, 9, 13, 0.72);
    border-bottom: 1px solid var(--line-1);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 64px;
    padding-block: 12px;
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ink-1);
    flex-shrink: 0;
  }
  .brand-mark {
    display: inline-flex;
    width: 28px; height: 28px;
    transition: transform 220ms ease;
  }
  .site-header__brand:hover .brand-mark { transform: rotate(-6deg); }
  .brand-text {
    display: flex; flex-direction: column; line-height: 1;
  }
  .brand-text__name {
    font-weight: 700; font-size: 0.95rem; letter-spacing: -0.005em;
  }
  .brand-text__sub {
    font-size: 0.7rem; color: var(--gold-1); margin-top: 2px;
    font-family: var(--font-mono); letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .site-nav {
    margin-left: auto;
    position: relative;
  }
  .site-nav__list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0; padding: 0;
    gap: 4px;
  }
  .site-nav__list a {
    display: inline-block;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 0.86rem;
    color: var(--ink-2);
    font-weight: 500;
  }
  .site-nav__list a:hover { color: var(--ink-1); background: var(--bg-2); }
  .site-nav__list a.active { color: var(--gold-1); background: rgba(200, 164, 90, 0.07); }

  .site-nav__toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--line-2);
    border-radius: 8px;
    padding: 8px;
    color: var(--ink-2);
    cursor: pointer;
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }

  .site-header__actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

  @media (max-width: 980px) {
    .site-nav__toggle { display: inline-flex; }
    .site-nav__list {
      position: absolute;
      right: 0;
      top: 100%;
      margin-top: 8px;
      display: none;
      flex-direction: column;
      background: var(--bg-1);
      border: 1px solid var(--line-2);
      border-radius: 12px;
      padding: 8px;
      min-width: 200px;
      box-shadow: var(--shadow-1);
    }
    .site-nav.open .site-nav__list { display: flex; }
    .site-nav__list a { padding: 10px 12px; }
  }
  @media (max-width: 540px) {
    .brand-text__name { font-size: 0.85rem; }
    .brand-text__sub { display: none; }
  }
</style>

<script>
  const root = document.querySelector('.site-nav');
  const btn = root?.querySelector('.site-nav__toggle');
  if (root && btn) {
    btn.addEventListener('click', () => {
      const open = root.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }
</script>
