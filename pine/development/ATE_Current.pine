//@version=6
indicator("Austin Trading Engine v2.2", shorttitle="ATE v2.2", overlay=true, max_labels_count=500)

// ═════════════════════════════════════════════════════════════════════════════
// AUSTIN TRADING ENGINE v2.2
// Diagnostic-only RiskEngine release
//
// RiskEngine v1.0.0-draft:
// - Dashboard display: YES
// - Research Mode output: YES
// - ConfidenceEngine impact: NO
// - DecisionEngine impact: NO
// - Entry/exit impact: NO
// - Position sizing impact: NO
// - Stop logic impact: NO
// - Risk alerts: NO
// ═════════════════════════════════════════════════════════════════════════════


// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────

grpProfile = "Market Profile"
profile = input.string("Gold", "Profile", options=["Gold", "Silver", "Gilts", "Forex", "Stocks", "Custom"], group=grpProfile)

grpMA = "MA Engine"
maType = input.string("EMA", "MA Type", options=["SMA", "EMA", "WMA", "Hull"], group=grpMA)
src = input.source(close, "Source", group=grpMA)

grpFast = "Fast Cluster"
fLen1 = input.int(4, "Fast 1", minval=1, group=grpFast)
fLen2 = input.int(8, "Fast 2", minval=1, group=grpFast)
fLen3 = input.int(13, "Fast 3", minval=1, group=grpFast)

grpMed = "Medium Cluster"
mLen1 = input.int(21, "Medium 1", minval=1, group=grpMed)
mLen2 = input.int(34, "Medium 2", minval=1, group=grpMed)
mLen3 = input.int(55, "Medium 3", minval=1, group=grpMed)

grpSlow = "Slow Cluster"
sLen1 = input.int(50, "Slow 1", minval=1, group=grpSlow)
sLen2 = input.int(100, "Slow 2", minval=1, group=grpSlow)
sLen3 = input.int(200, "Slow 3", minval=1, group=grpSlow)

grpStruct = "Structure Engine"
showStructure = input.bool(true, "Enable Structure Engine", group=grpStruct)
pivotLen = input.int(5, "Swing Pivot Length", minval=2, maxval=20, group=grpStruct)

grpMom = "Momentum Engine"
showMomentum = input.bool(true, "Enable Momentum Engine", group=grpMom)
rsiLen = input.int(14, "RSI Length", minval=2, group=grpMom)
macdFast = input.int(12, "MACD Fast", minval=1, group=grpMom)
macdSlow = input.int(26, "MACD Slow", minval=1, group=grpMom)
macdSignal = input.int(9, "MACD Signal", minval=1, group=grpMom)
adxLen = input.int(14, "ADX Length", minval=2, group=grpMom)
adxSmooth = input.int(14, "ADX Smoothing", minval=2, group=grpMom)

grpVol = "Volatility Engine v1.0.0-draft"
showVolatility = input.bool(true, "Enable Volatility Diagnostics", group=grpVol)
atrLength = input.int(14, "ATR Length", minval=5, maxval=100, group=grpVol)
atrBaselineLength = input.int(100, "ATR Baseline Length", minval=20, maxval=500, group=grpVol)
bbLength = input.int(20, "BB Length", minval=10, maxval=100, group=grpVol)
bbStdDev = input.float(2.0, "BB StdDev", minval=1.0, maxval=3.0, step=0.1, group=grpVol)
bbBaselineLength = input.int(100, "BB Baseline Length", minval=20, maxval=500, group=grpVol)
shockLookback = input.int(20, "Shock Lookback", minval=5, maxval=100, group=grpVol)
shockMultiplier = input.float(2.5, "Shock Multiplier", minval=1.5, maxval=5.0, step=0.1, group=grpVol)
compressionThreshold = input.float(0.75, "Compression Threshold", minval=0.25, maxval=1.0, step=0.05, group=grpVol)
normalUpperThreshold = input.float(1.25, "Normal Upper Threshold", minval=1.0, maxval=1.75, step=0.05, group=grpVol)
elevatedThreshold = input.float(1.75, "Elevated Threshold", minval=1.25, maxval=3.0, step=0.05, group=grpVol)
unstableThreshold = input.float(2.50, "Unstable Threshold", minval=1.75, maxval=5.0, step=0.05, group=grpVol)
volSlopeLookback = input.int(5, "Volatility Slope Lookback", minval=2, maxval=20, group=grpVol)

grpConf = "Confidence Engine"
showConfidence = input.bool(true, "Enable Confidence Engine", group=grpConf)
trendWeight = input.float(40.0, "Trend Weight", minval=0, maxval=100, group=grpConf)
structureWeight = input.float(30.0, "Structure Weight", minval=0, maxval=100, group=grpConf)
momentumWeight = input.float(30.0, "Momentum Weight", minval=0, maxval=100, group=grpConf)

grpRisk = "Risk Engine v1.0.0-draft"
showRisk = input.bool(true, "Enable Risk Diagnostics", group=grpRisk)
riskVolElevatedScore = input.float(25.0, "Risk Vol Elevated Score", minval=0, maxval=100, step=1, group=grpRisk)
riskExtensionAtrLow = input.float(1.5, "Risk Extension ATR Low", minval=0.5, maxval=5.0, step=0.1, group=grpRisk)
riskExtensionAtrHigh = input.float(3.0, "Risk Extension ATR High", minval=1.0, maxval=10.0, step=0.1, group=grpRisk)
riskSwingAtr = input.float(2.0, "Risk Swing ATR", minval=0.5, maxval=6.0, step=0.1, group=grpRisk)
riskConfidenceRiskHigh = input.float(80.0, "Risk Confidence High", minval=50, maxval=100, step=1, group=grpRisk)
riskConfidenceRiskLow = input.float(20.0, "Risk Confidence Low", minval=0, maxval=50, step=1, group=grpRisk)
riskSmoothingLength = input.int(3, "Risk Smoothing Length", minval=1, maxval=20, group=grpRisk)

grpVisual = "Visuals"
showFast = input.bool(true, "Show Fast MAs", group=grpVisual)
showMed = input.bool(true, "Show Medium MAs", group=grpVisual)
showSlow = input.bool(true, "Show Slow MAs", group=grpVisual)
showDash = input.bool(true, "Show Dashboard", group=grpVisual)
showSignals = input.bool(true, "Show Signals", group=grpVisual)
showBg = input.bool(true, "Trend Background", group=grpVisual)
slopeLookback = input.int(3, "MA Slope Lookback", minval=1, maxval=20, group=grpVisual)

grpResearch = "ATE Research Mode"
showResearch = input.bool(false, "Show Research Output", group=grpResearch)

grpTrend = "Trend Engine v0.2.0-spec-impl"
showTrend = input.bool(true, "Enable Trend Diagnostics", group=grpTrend)
trendEmaLen = input.int(50, "Trend EMA Length", minval=5, maxval=400, group=grpTrend)
trendSlopeLookback = input.int(5, "Trend Slope Lookback", minval=1, maxval=50, group=grpTrend)
trendSlopeMin = input.float(0.001, "Trend Slope Min", minval=0.0, maxval=0.1, step=0.001, group=grpTrend)
trendSwingLen = input.int(5, "Trend Swing Length", minval=2, maxval=50, group=grpTrend)
trendStructureBars = input.int(3, "Trend Structure Confirm Bars", minval=1, maxval=20, group=grpTrend)
trendStrengthScale = input.float(50.0, "Trend Strength Scale", minval=1.0, maxval=200.0, step=1.0, group=grpTrend)
trendAgeMax = input.int(250, "Trend Age Max", minval=10, maxval=1000, group=grpTrend)


// ─────────────────────────────────────────────────────────────────────────────
// FUNCTIONS
// ─────────────────────────────────────────────────────────────────────────────

f_ma(_src, _len, _type) =>
    halfLen = math.max(1, math.floor(_len / 2))
    sqrtLen = math.max(1, math.round(math.sqrt(_len)))
    switch _type
        "SMA" => ta.sma(_src, _len)
        "EMA" => ta.ema(_src, _len)
        "WMA" => ta.wma(_src, _len)
        "Hull" => ta.wma(2 * ta.wma(_src, halfLen) - ta.wma(_src, _len), sqrtLen)

f_up(v) =>
    not na(v[slopeLookback]) and v > v[slopeLookback]

f_dn(v) =>
    not na(v[slopeLookback]) and v < v[slopeLookback]

f_boolScore(cond, pts) =>
    cond ? pts : 0.0

f_state(score) =>
    score >= 80 ? "STRONG BULL" :
     score >= 60 ? "BULL" :
     score > 40 ? "NEUTRAL" :
     score > 20 ? "BEAR" : "STRONG BEAR"

f_scoreColor(score) =>
    score >= 80 ? color.lime :
     score >= 60 ? color.green :
     score > 40 ? color.yellow :
     score > 20 ? color.orange : color.red

f_volColor(score) =>
    na(score) ? color.gray :
     score >= 80 ? color.lime :
     score >= 60 ? color.green :
     score >= 40 ? color.yellow :
     score >= 20 ? color.orange : color.red

f_riskColor(score) =>
    na(score) ? color.gray :
     score <= 15 ? color.lime :
     score <= 35 ? color.green :
     score <= 55 ? color.yellow :
     score <= 75 ? color.orange : color.red

f_fmt(v) =>
    na(v) ? "na" : str.tostring(v, "#.##")

f_clamp(v, lo, hi) =>
    na(v) ? na : math.max(lo, math.min(hi, v))

f_linear(v, lo, hi, outLo, outHi) =>
    na(v) or hi == lo ? na : outLo + ((v - lo) / (hi - lo)) * (outHi - outLo)


// ─────────────────────────────────────────────────────────────────────────────
// MA CALCULATIONS
// ─────────────────────────────────────────────────────────────────────────────

f1 = f_ma(src, fLen1, maType)
f2 = f_ma(src, fLen2, maType)
f3 = f_ma(src, fLen3, maType)

m1 = f_ma(src, mLen1, maType)
m2 = f_ma(src, mLen2, maType)
m3 = f_ma(src, mLen3, maType)

s1 = f_ma(src, sLen1, maType)
s2 = f_ma(src, sLen2, maType)
s3 = f_ma(src, sLen3, maType)


// ─────────────────────────────────────────────────────────────────────────────
// COLOURS
// ─────────────────────────────────────────────────────────────────────────────

fastUpCol = color.new(#00E5FF, 0)
fastDnCol = color.new(#FF1744, 0)
medUpCol = color.new(#00E676, 0)
medDnCol = color.new(#FF9100, 0)
slowUpCol = color.new(#2979FF, 0)
slowDnCol = color.new(#AA00FF, 0)


// ─────────────────────────────────────────────────────────────────────────────
// TREND SCORE ENGINE
// ─────────────────────────────────────────────────────────────────────────────

priceScore = f_boolScore(close > s1, 5) + f_boolScore(close > s2, 5) + f_boolScore(close > s3, 10)

slowAlignScore =
     s1 > s2 and s2 > s3 ? 30 :
     s1 > s2 or s2 > s3 ? 15 : 0

slopeScore = f_boolScore(f_up(s1), 7) + f_boolScore(f_up(s2), 7) + f_boolScore(f_up(s3), 6)

fastScore =
     f1 > f2 and f2 > f3 ? 15 :
     f1 > f2 or f2 > f3 ? 8 : 0

mediumScore =
     m1 > m2 and m2 > m3 ? 15 :
     m1 > m2 or m2 > m3 ? 8 : 0

trendScore = priceScore + slowAlignScore + slopeScore + fastScore + mediumScore
marketState = f_state(trendScore)
stateCol = f_scoreColor(trendScore)


// ─────────────────────────────────────────────────────────────────────────────
// STRUCTURE ENGINE
// ─────────────────────────────────────────────────────────────────────────────

swingHigh = ta.pivothigh(high, pivotLen, pivotLen)
swingLow = ta.pivotlow(low, pivotLen, pivotLen)

var float lastHigh = na
var float prevHigh = na
var float lastLow = na
var float prevLow = na

if not na(swingHigh)
    prevHigh := lastHigh
    lastHigh := swingHigh

if not na(swingLow)
    prevLow := lastLow
    lastLow := swingLow

higherHigh = not na(lastHigh) and not na(prevHigh) and lastHigh > prevHigh
lowerHigh = not na(lastHigh) and not na(prevHigh) and lastHigh < prevHigh
higherLow = not na(lastLow) and not na(prevLow) and lastLow > prevLow
lowerLow = not na(lastLow) and not na(prevLow) and lastLow < prevLow

bullStructure = higherHigh and higherLow
bearStructure = lowerHigh and lowerLow

bosBull = not na(lastHigh) and close > lastHigh
bosBear = not na(lastLow) and close < lastLow

structureScore =
     not showStructure ? 50 :
     bullStructure and bosBull ? 100 :
     bullStructure ? 80 :
     higherLow or higherHigh ? 65 :
     bearStructure and bosBear ? 0 :
     bearStructure ? 20 :
     lowerLow or lowerHigh ? 35 : 50

structureState =
     structureScore >= 80 ? "BULLISH STRUCTURE" :
     structureScore >= 60 ? "LEANING BULLISH" :
     structureScore > 40 ? "NEUTRAL" :
     structureScore > 20 ? "LEANING BEARISH" : "BEARISH STRUCTURE"

structureCol = f_scoreColor(structureScore)


// ─────────────────────────────────────────────────────────────────────────────
// MOMENTUM ENGINE
// ─────────────────────────────────────────────────────────────────────────────

rsiVal = ta.rsi(close, rsiLen)
rsiUp = rsiVal > rsiVal[1]

[macdLine, macdSig, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignal)
macdBull = macdLine > macdSig
macdBear = macdLine < macdSig
macdRising = macdHist > macdHist[1]

[plusDI, minusDI, adxVal] = ta.dmi(adxLen, adxSmooth)
adxRising = adxVal > adxVal[1]

rsiScore =
     rsiVal >= 55 and rsiVal <= 70 and rsiUp ? 35 :
     rsiVal > 50 and rsiVal < 80 ? 28 :
     rsiVal >= 45 and rsiVal <= 55 ? 18 :
     rsiVal < 45 ? 8 : 15

macdScore =
     macdBull and macdHist > 0 and macdRising ? 35 :
     macdBull and macdHist > 0 ? 28 :
     macdBull ? 22 :
     macdBear and macdHist < 0 and not macdRising ? 5 : 15

adxScore =
     adxVal >= 25 and adxVal <= 45 and adxRising ? 30 :
     adxVal >= 25 ? 24 :
     adxVal >= 18 ? 16 : 8

momentumScore = showMomentum ? rsiScore + macdScore + adxScore : 50

momentumState =
     momentumScore >= 80 ? "STRONG MOMENTUM" :
     momentumScore >= 60 ? "BULLISH MOMENTUM" :
     momentumScore > 40 ? "NEUTRAL MOMENTUM" :
     momentumScore > 20 ? "BEARISH MOMENTUM" : "WEAK MOMENTUM"

momentumCol = f_scoreColor(momentumScore)


// ─────────────────────────────────────────────────────────────────────────────
// VOLATILITY ENGINE v1.0.0-draft
// DIAGNOSTIC ONLY — DOES NOT AFFECT CONFIDENCE, RISK DECISIONS OR SIGNALS
// ─────────────────────────────────────────────────────────────────────────────

volEngineVersion = "1.0.0-draft"

volAtr = ta.atr(atrLength)
volAtrPercent = close == 0 ? na : (volAtr / close) * 100.0
volAtrBaseline = ta.sma(volAtrPercent, atrBaselineLength)
volAtrRatio = na(volAtrBaseline) or volAtrBaseline == 0 ? na : volAtrPercent / volAtrBaseline

volBbBasis = ta.sma(close, bbLength)
volBbDev = bbStdDev * ta.stdev(close, bbLength)
volBbUpper = volBbBasis + volBbDev
volBbLower = volBbBasis - volBbDev
volBbWidthRaw = volBbBasis == 0 ? na : (volBbUpper - volBbLower) / volBbBasis
volBbWidthBaseline = ta.sma(volBbWidthRaw, bbBaselineLength)
volBbWidthRatio = na(volBbWidthBaseline) or volBbWidthBaseline == 0 ? na : volBbWidthRaw / volBbWidthBaseline

volValidAtr = not na(volAtrRatio)
volValidBb = not na(volBbWidthRatio)

volCombinedRatio =
     volValidAtr and volValidBb ? (volAtrRatio + volBbWidthRatio) / 2.0 :
     volValidAtr ? volAtrRatio :
     volValidBb ? volBbWidthRatio : na

volSlope = not na(volCombinedRatio) and not na(volCombinedRatio[volSlopeLookback]) ? volCombinedRatio - volCombinedRatio[volSlopeLookback] : na

volTrueRange = ta.tr(true)
volTrueRangeBaseline = ta.sma(volTrueRange, shockLookback)
volShockFlag = not na(volTrueRangeBaseline) and volTrueRangeBaseline > 0 and volTrueRange >= volTrueRangeBaseline * shockMultiplier

volUnknown = not showVolatility or na(volCombinedRatio)

volState =
     volUnknown ? "unknown" :
     volShockFlag ? "shock" :
     volCombinedRatio >= unstableThreshold ? "unstable" :
     volCombinedRatio >= elevatedThreshold ? "elevated" :
     volCombinedRatio < compressionThreshold ? "compressed" :
     volCombinedRatio <= normalUpperThreshold ? "normal" :
     volCombinedRatio > normalUpperThreshold and volSlope > 0 ? "expanding" :
     "normal"

volDirection =
     volUnknown ? "none" :
     volShockFlag ? "unstable" :
     volCombinedRatio >= unstableThreshold ? "unstable" :
     na(volSlope) ? "none" :
     volSlope > 0 ? "expanding" :
     volSlope < 0 ? "contracting" : "stable"

volScore =
     volState == "normal" ? 85.0 :
     volState == "expanding" ? 70.0 :
     volState == "compressed" ? 55.0 :
     volState == "elevated" ? 45.0 :
     volState == "unstable" ? 20.0 :
     volState == "shock" ? 10.0 : na

volReason =
     volState == "unknown" ? "Insufficient volatility data" :
     volState == "shock" ? "True range shock detected" :
     volState == "unstable" ? "Volatility extremely above baseline" :
     volState == "elevated" ? "Volatility materially above baseline" :
     volState == "expanding" ? "Volatility expanding above normal" :
     volState == "compressed" ? "Volatility compressed below baseline" :
     "Volatility near asset baseline"

volCol = f_volColor(volScore)


// ─────────────────────────────────────────────────────────────────────────────
// CONFIDENCE ENGINE
// IMPORTANT: VolatilityEngine and RiskEngine are NOT used in confidenceScore
// ─────────────────────────────────────────────────────────────────────────────

totalWeight = trendWeight + structureWeight + momentumWeight
normTrendWeight = totalWeight == 0 ? 0.0 : trendWeight / totalWeight
normStructureWeight = totalWeight == 0 ? 0.0 : structureWeight / totalWeight
normMomentumWeight = totalWeight == 0 ? 0.0 : momentumWeight / totalWeight

confidenceScore =
     showConfidence and totalWeight > 0 ?
     (trendScore * normTrendWeight) +
     (structureScore * normStructureWeight) +
     (momentumScore * normMomentumWeight) : 50

confidenceState =
     confidenceScore >= 80 ? "HIGH CONFIDENCE" :
     confidenceScore >= 60 ? "GOOD CONFIDENCE" :
     confidenceScore > 40 ? "LOW / MIXED" :
     confidenceScore > 20 ? "BEARISH CONFIDENCE" : "STRONG BEARISH"

confidenceCol = f_scoreColor(confidenceScore)


// ─────────────────────────────────────────────────────────────────────────────
// RISK ENGINE v1.0.0-draft
// DIAGNOSTIC ONLY — DOES NOT AFFECT CONFIDENCE, DECISION OR SIGNALS
// ─────────────────────────────────────────────────────────────────────────────

riskEngineVersion = "1.0.0-draft"

// Diagnostic input snapshots
riskDiagVolScore = volScore
riskDiagVolShockFlag = volShockFlag
riskDiagConfidenceScore = confidenceScore

// Extension diagnostic
riskDiagExtBarRangeAtr = na(volAtr) or volAtr == 0 ? na : (high - low) / volAtr

// Structure diagnostic using nearest confirmed swing level
riskHasHigh = not na(lastHigh)
riskHasLow = not na(lastLow)

riskNearestSwingDistance =
     riskHasHigh and riskHasLow ? math.min(math.abs(close - lastHigh), math.abs(close - lastLow)) :
     riskHasHigh ? math.abs(close - lastHigh) :
     riskHasLow ? math.abs(close - lastLow) : na

riskDiagStructLastSwingAtr = na(volAtr) or volAtr == 0 or na(riskNearestSwingDistance) ? na : riskNearestSwingDistance / volAtr

// Conflict diagnostic
riskTrendMomentumDiff = trendScore - momentumScore
riskTrendMomentumCrossBars = ta.barssince(ta.cross(riskTrendMomentumDiff, 0))
riskDiagConflictCross = not na(riskTrendMomentumCrossBars) and riskTrendMomentumCrossBars <= riskSmoothingLength

riskDiagInsufficientData = not showRisk or na(volAtr) or na(riskDiagExtBarRangeAtr) or na(riskDiagStructLastSwingAtr) or na(confidenceScore)

// Volatility risk contribution: 0 to 35
riskVolBase =
     na(riskDiagVolScore) ? 10.0 :
     riskDiagVolScore < riskVolElevatedScore ? 10.0 :
     riskDiagVolScore <= 75 ? 0.0 :
     riskDiagVolScore < 90 ? 5.0 : 15.0

riskVolRaw = f_clamp(riskVolBase + (riskDiagVolShockFlag ? 20.0 : 0.0), 0.0, 35.0)

riskVolState =
     riskVolRaw <= 5 ? "volLow" :
     riskVolRaw <= 15 ? "volElev" :
     riskVolRaw <= 25 ? "volTense" : "volExtreme"

// Extension risk contribution: 0 to 30
riskExtRawUnclamped =
     na(riskDiagExtBarRangeAtr) ? 10.0 :
     riskDiagExtBarRangeAtr <= riskExtensionAtrLow ? 0.0 :
     riskDiagExtBarRangeAtr <= riskExtensionAtrHigh ?
         f_linear(riskDiagExtBarRangeAtr, riskExtensionAtrLow, riskExtensionAtrHigh, 0.0, 20.0) : 30.0

riskExtRaw = f_clamp(riskExtRawUnclamped, 0.0, 30.0)

riskExtState =
     riskExtRaw <= 5 ? "extLow" :
     riskExtRaw <= 15 ? "extNorm" :
     riskExtRaw <= 25 ? "extStretch" : "extExtreme"

// Structure risk contribution: 0 to 20
riskStructMid = riskSwingAtr * 1.5
riskStructHigh = riskSwingAtr * 2.0

riskStructRawUnclamped =
     not showStructure ? 0.0 :
na(riskDiagStructLastSwingAtr) ? 10.0 :
riskDiagStructLastSwingAtr <= riskSwingAtr ? 0.0 :
riskDiagStructLastSwingAtr <= riskStructMid ?
f_linear(riskDiagStructLastSwingAtr, riskSwingAtr, riskStructMid, 0.0, 12.0) :
riskDiagStructLastSwingAtr <= riskStructHigh ?
f_linear(riskDiagStructLastSwingAtr, riskStructMid, riskStructHigh, 12.0, 18.0) : 20.0
riskStructRaw = f_clamp(riskStructRawUnclamped, 0.0, 20.0)
riskStructState =
riskStructRaw <= 4 ? "structTight" :
riskStructRaw <= 10 ? "structNorm" :
riskStructRaw <= 15 ? "structStretch" : "structRisk"
// Conflict risk contribution: 0 to 15
riskConflictBase =
confidenceScore >= riskConfidenceRiskHigh ? 10.0 :
confidenceScore <= riskConfidenceRiskLow ? 10.0 : 0.0
riskConflictRaw = f_clamp(riskConflictBase + (riskDiagConflictCross ? 5.0 : 0.0), 0.0, 15.0)
riskConflictState =
riskConflictRaw == 0 ? "conflictNone" :
riskConflictRaw <= 5 ? "conflictMild" :
riskConflictRaw <= 10 ? "conflictElevated" : "conflictHigh"
// Total risk diagnostic score
riskTotalRaw = riskVolRaw + riskExtRaw + riskStructRaw + riskConflictRaw
riskSmoothedRaw = ta.sma(riskTotalRaw, riskSmoothingLength)
riskScore = riskDiagInsufficientData ? na : f_clamp(riskSmoothedRaw, 0.0, 100.0)
// Risk state
riskState =
na(riskScore) ? "unknown" :
riskScore >= 75 ? "extreme" :
riskScore >= 55 ? "tense" :
riskScore >= 35 ? "elevated" :
riskScore >= 15 ? "normal" : "calm"
// Risk direction
riskMultipleComponentsHigh = (riskVolRaw > 25 ? 1 : 0) + (riskExtRaw > 25 ? 1 : 0) + (riskStructRaw > 15 ? 1 : 0) + (riskConflictRaw > 10 ? 1 : 0)
riskDirection =
na(riskScore) ? "none" :
riskConflictRaw >= 10 and riskVolRaw >= 15 ? "conflict" :
riskMultipleComponentsHigh >= 2 ? "indeterminate" :
not na(riskScore[1]) and riskScore > riskScore[1] + 5 ? "elevated" : "stable"
// Risk reason

riskReason =
riskState == "unknown" ? "Insufficient risk data" :
riskConflictRaw >= 10 and riskVolRaw >= 15 ? "Conflict and volatility pressure" :
riskMultipleComponentsHigh >= 2 ? "Multiple risk components elevated" :
riskVolRaw >= riskExtRaw and riskVolRaw >= riskStructRaw and riskVolRaw >= riskConflictRaw and riskVolRaw > 5 ? "Volatility component dominant" :
riskExtRaw >= riskVolRaw and riskExtRaw >= riskStructRaw and riskExtRaw >= riskConflictRaw and riskExtRaw > 5 ? "Extension component dominant" :
riskStructRaw >= riskVolRaw and riskStructRaw >= riskExtRaw and riskStructRaw >= riskConflictRaw and riskStructRaw > 5 ? "Structure component dominant" :
riskConflictRaw > 0 ? "Conflict component active" :
riskState == "calm" ? "Low component pressure" : "Risk components within range"
riskCol = f_riskColor(riskScore)
// ─────────────────────────────────────────────────────────────────────────────
// TREND ENGINE v0.2.0-spec-impl
//
// TrendEngine v0.2.0-spec-impl:
// - Dashboard display: YES (research-only, dev mirror)
// - Research Mode output: YES (research-only, dev mirror)
// - ConfidenceEngine impact: NO
// - DecisionEngine impact: NO
// - Entry/exit impact: NO
// - Position sizing impact: NO
// - Stop logic impact: NO
// - Trend alerts: NO
// - TrendEngine does NOT replace trendScore / marketState
// ─────────────────────────────────────────────────────────────────────────────

trendEngineVersion = "0.2.0-spec-impl"

// Persistent state variable — declared before its first use to satisfy
// Pine v6 forward-reference rules.
var string trendState = "UNKNOWN"

// Insufficient data check (warm-up)
trendDiagInsufficientData = not showTrend or bar_index < trendEmaLen + trendSlopeLookback

// EMA and slope
trendEma = ta.ema(close, trendEmaLen)
trendEmaPrior = trendEma[trendSlopeLookback]
trendDiagEmaSlope = na(trendEmaPrior) or trendEmaPrior == 0 ? 0.0 : (trendEma - trendEmaPrior) / trendEmaPrior

// Slope classification
slopeIsUp   = trendDiagEmaSlope >  trendSlopeMin
slopeIsDown = trendDiagEmaSlope < -trendSlopeMin
slopeIsFlat = not slopeIsUp and not slopeIsDown

// Structure classification. TrendEngine owns its pivot length and confirmed
// pivot history; it must not silently inherit StructureEngine's `pivotLen`.
trendPivotHigh = ta.pivothigh(high, trendSwingLen, trendSwingLen)
trendPivotLow = ta.pivotlow(low, trendSwingLen, trendSwingLen)
var float trendLastHigh = na
var float trendPrevHigh = na
var float trendLastLow = na
var float trendPrevLow = na
if not na(trendPivotHigh)
    trendPrevHigh := trendLastHigh
    trendLastHigh := trendPivotHigh
if not na(trendPivotLow)
    trendPrevLow := trendLastLow
    trendLastLow := trendPivotLow
trendDiagHigherHigh = not na(trendLastHigh) and not na(trendPrevHigh) and trendLastHigh > trendPrevHigh
trendDiagHigherLow  = not na(trendLastLow) and not na(trendPrevLow) and trendLastLow > trendPrevLow
trendDiagLowerHigh  = not na(trendLastHigh) and not na(trendPrevHigh) and trendLastHigh < trendPrevHigh
trendDiagLowerLow   = not na(trendLastLow) and not na(trendPrevLow) and trendLastLow < trendPrevLow
structIsUp   = trendDiagHigherHigh and trendDiagHigherLow
structIsDown = trendDiagLowerHigh  and trendDiagLowerLow
structIsFlat = not structIsUp and not structIsDown

// Agreement metric
trendDiagAgreement =
     trendDiagInsufficientData ? 0.0 :
     slopeIsUp   and structIsUp   ? 1.0 :
     slopeIsDown and structIsDown ? 1.0 :
     slopeIsUp   and structIsFlat ? 0.6 :
     slopeIsFlat and structIsUp   ? 0.6 :
     slopeIsDown and structIsFlat ? 0.6 :
     slopeIsFlat and structIsDown ? 0.6 :
     slopeIsFlat and structIsFlat ? 0.5 : 0.0

// Candidate state
candidateUp   = slopeIsUp   and structIsUp
candidateDown = slopeIsDown and structIsDown
candidateIsUpOrDown = candidateUp or candidateDown

// State confirmation: candidate must hold for trendStructureBars bars
trendCandidateState = candidateUp ? "UP" : candidateDown ? "DOWN" : "RANGE"
var string trendCandidatePrior = na
var int trendCandidateHoldCount = 0
if trendCandidateState == trendCandidatePrior
    trendCandidateHoldCount += 1
else
    trendCandidateHoldCount := 1
trendCandidatePrior := trendCandidateState

// Adopt candidate only after confirmation window (with one exception: warm-up from UNKNOWN)
trendDiagStateConfirmBars = candidateUp or candidateDown ? trendCandidateHoldCount : 0

// State adoption (with confirmation) — trendState is var, declared above.
if trendDiagInsufficientData
    trendState := "UNKNOWN"
else
    if trendState == "UNKNOWN"
        // First non-UNKNOWN state adopted immediately
        trendState := trendCandidateState
    else
        // Subsequent changes require confirmation window
        if trendCandidateState != trendState and trendDiagStateConfirmBars >= trendStructureBars
            trendState := trendCandidateState

// Strength
trendStrengthRaw = trendDiagInsufficientData ? na : (candidateIsUpOrDown ? trendDiagAgreement * trendStrengthScale / 100.0 : 0.0)
trendStrength = trendDiagInsufficientData or na(trendStrengthRaw) ? na : f_clamp(trendStrengthRaw, 0.0, 1.0)

// Age tracking — bars since current state was adopted.
// ta.barssince counts bars since a true condition; using stateChanged = (trendState != trendState[1]).
trendStateChanged = trendState != trendState[1]
trendAgeBarsSinceChange = ta.barssince(trendStateChanged)
trendAge =
     trendDiagInsufficientData ? na :
     trendState == "UNKNOWN" ? 0 :
     na(trendAgeBarsSinceChange) ? 0 :
     math.min(trendAgeMax, trendAgeBarsSinceChange)

// Trend state colour (neutral diagnostic, not buy/sell)
trendCol =
     trendState == "UP"   ? color.new(color.teal, 0) :
     trendState == "DOWN" ? color.new(color.maroon, 0) :
     color.gray

// ─────────────────────────────────────────────────────────────────────────────
// PLOTS
// ─────────────────────────────────────────────────────────────────────────────
plot(showFast ? f1 : na, "Fast 1", color=f_up(f1) ? fastUpCol : f_dn(f1) ? fastDnCol : color.gray, linewidth=1)
plot(showFast ? f2 : na, "Fast 2", color=f_up(f2) ? fastUpCol : f_dn(f2) ? fastDnCol : color.gray, linewidth=1)
plot(showFast ? f3 : na, "Fast 3", color=f_up(f3) ? fastUpCol : f_dn(f3) ? fastDnCol : color.gray, linewidth=1)
plot(showMed ? m1 : na, "Medium 1", color=f_up(m1) ? medUpCol : f_dn(m1) ? medDnCol : color.gray, linewidth=2)
plot(showMed ? m2 : na, "Medium 2", color=f_up(m2) ? medUpCol : f_dn(m2) ? medDnCol : color.gray, linewidth=2)
plot(showMed ? m3 : na, "Medium 3", color=f_up(m3) ? medUpCol : f_dn(m3) ? medDnCol : color.gray, linewidth=2)
plot(showSlow ? s1 : na, "Slow 1", color=f_up(s1) ? slowUpCol : f_dn(s1) ? slowDnCol : color.gray, linewidth=2)
plot(showSlow ? s2 : na, "Slow 2", color=f_up(s2) ? slowUpCol : f_dn(s2) ? slowDnCol : color.gray, linewidth=3)
plot(showSlow ? s3 : na, "Slow 3", color=f_up(s3) ? slowUpCol : f_dn(s3) ? slowDnCol : color.gray, linewidth=4)
bgcolor(showBg ? color.new(confidenceCol, 90) : na)
// ─────────────────────────────────────────────────────────────────────────────
// SIGNALS
// RiskEngine creates no signals or alerts in ATE v2.2
// ─────────────────────────────────────────────────────────────────────────────
goldenCross = ta.crossover(s1, s3)
deathCross = ta.crossunder(s1, s3)
strongBullStart = trendScore >= 80 and trendScore[1] < 80
strongBearStart = trendScore <= 20 and trendScore[1] > 20
momentumBull = momentumScore >= 70 and momentumScore[1] < 70
momentumBear = momentumScore <= 30 and momentumScore[1] > 30
confidenceBull = confidenceScore >= 75 and confidenceScore[1] < 75
confidenceBear = confidenceScore <= 30 and confidenceScore[1] > 30
plotshape(showSignals and goldenCross, title="Golden Cross", style=shape.diamond, location=location.belowbar, color=medUpCol, size=size.normal, text="GOLDEN", textcolor=color.white)
plotshape(showSignals and deathCross, title="Death Cross", style=shape.diamond, location=location.abovebar, color=medDnCol, size=size.normal, text="DEATH", textcolor=color.white)
plotshape(showSignals and strongBullStart, title="Strong Bull Start", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="ATE BULL", textcolor=color.white)
plotshape(showSignals and strongBearStart, title="Strong Bear Start", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="ATE BEAR", textcolor=color.white)
plotshape(showStructure and not na(swingHigh), title="Swing High", style=shape.circle, location=location.abovebar, color=color.red, size=size.tiny, offset=-pivotLen)
plotshape(showStructure and not na(swingLow), title="Swing Low", style=shape.circle, location=location.belowbar, color=color.lime, size=size.tiny, offset=-pivotLen)
plotshape(showStructure and bosBull, title="Bullish BOS", style=shape.labelup, location=location.belowbar, color=color.lime, text="BOS", textcolor=color.white, size=size.tiny)
plotshape(showStructure and bosBear, title="Bearish BOS", style=shape.labeldown, location=location.abovebar, color=color.red, text="BOS", textcolor=color.white, size=size.tiny)
// ─────────────────────────────────────────────────────────────────────────────
// DASHBOARD
// ─────────────────────────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 43, border_width=1)
if barstate.islast
table.clear(dash, 0, 0, 1, 42)
if showDash
table.cell(dash, 0, 0, "AUSTIN TRADING ENGINE", text_color=color.white, bgcolor=color.new(color.black, 10), text_size=size.normal)
table.cell(dash, 1, 0, "v2.2", text_color=color.white, bgcolor=color.new(color.black, 10), text_size=size.normal)
table.cell(dash, 0, 1, "Profile", text_color=color.white, bgcolor=color.new(color.gray, 70))
table.cell(dash, 1, 1, profile, text_color=color.white, bgcolor=color.new(color.gray, 70))
table.cell(dash, 0, 2, "Timeframe", text_color=color.white, bgcolor=color.new(color.gray, 70))
table.cell(dash, 1, 2, timeframe.period, text_color=color.white, bgcolor=color.new(color.gray, 70))
table.cell(dash, 0, 3, "Trend Score", text_color=color.white, bgcolor=color.new(color.black, 20))
table.cell(dash, 1, 3, str.tostring(trendScore, "#") + " / 100", text_color=stateCol, bgcolor=color.new(color.black, 20))
table.cell(dash, 0, 4, "Market State", text_color=color.white, bgcolor=color.new(color.black, 20))
table.cell(dash, 1, 4, marketState, text_color=stateCol, bgcolor=color.new(color.black, 20))
table.cell(dash, 0, 5, "Structure Score", text_color=color.white, bgcolor=color.new(color.gray, 80))
table.cell(dash, 1, 5, str.tostring(structureScore, "#") + " / 100", text_color=structureCol, bgcolor=color.new(color.gray, 80))
table.cell(dash, 0, 6, "Structure State", text_color=color.white, bgcolor=color.new(color.black, 20))
table.cell(dash, 1, 6, structureState, text_color=structureCol, bgcolor=color.new(color.black, 20))
table.cell(dash, 0, 7, "Momentum Score", text_color=color.white, bgcolor=color.new(color.gray, 80))
table.cell(dash, 1, 7, str.tostring(momentumScore, "#") + " / 100", text_color=momentumCol, bgcolor=color.new(color.gray, 80))
table.cell(dash, 0, 8, "Momentum State", text_color=color.white, bgcolor=color.new(color.black, 20))
table.cell(dash, 1, 8, momentumState, text_color=momentumCol, bgcolor=color.new(color.black, 20))
table.cell(dash, 0, 9, "Confidence Score", text_color=color.white, bgcolor=color.new(color.black, 20))
table.cell(dash, 1, 9, str.tostring(confidenceScore, "#") + " / 100", text_color=confidenceCol, bgcolor=color.new(color.black, 20))
table.cell(dash, 0, 10, "Confidence State", text_color=color.white, bgcolor=color.new(color.black, 20))
table.cell(dash, 1, 10, confidenceState, text_color=confidenceCol, bgcolor=color.new(color.black, 20))
table.cell(dash, 0, 11, "Volatility Score", text_color=color.white, bgcolor=color.new(color.gray, 80))
table.cell(dash, 1, 11, na(volScore) ? "na" : str.tostring(volScore, "#") + " / 100", text_color=volCol, bgcolor=color.new(color.gray, 80))
table.cell(dash, 0, 12, "Volatility State", text_color=color.white, bgcolor=color.new(color.black, 20))
table.cell(dash, 1, 12, volState, text_color=volCol, bgcolor=color.new(color.black, 20))
table.cell(dash, 0, 13, "Vol Direction", text_color=color.white, bgcolor=color.new(color.gray, 80))
table.cell(dash, 1, 13, volDirection, text_color=volCol, bgcolor=color.new(color.gray, 80))
table.cell(dash, 0, 14, "ATR % / Ratio", text_color=color.white, bgcolor=color.new(color.gray, 80))
table.cell(dash, 1, 14, f_fmt(volAtrPercent) + " / " + f_fmt(volAtrRatio), text_color=color.white, bgcolor=color.new(color.gray, 80))
table.cell(dash, 0, 15, "BB Ratio", text_color=color.white, bgcolor=color.new(color.gray, 80))
table.cell(dash, 1, 15, f_fmt(volBbWidthRatio), text_color=color.white, bgcolor=color.new(color.gray, 80))
table.cell(dash, 0, 16, "Combined Vol", text_color=color.white, bgcolor=color.new(color.gray, 80))
table.cell(dash, 1, 16, f_fmt(volCombinedRatio), text_color=color.white, bgcolor=color.new(color.gray, 80))
table.cell(dash, 0, 17, "Shock Flag", text_color=color.white, bgcolor=color.new(color.gray, 80))
table.cell(dash, 1, 17, volShockFlag ? "TRUE" : "false", text_color=volShockFlag ? color.red : color.white, bgcolor=color.new(color.gray, 80))
table.cell(dash, 0, 18, "Vol Reason", text_color=color.white, bgcolor=color.new(color.black, 20))
table.cell(dash, 1, 18, volReason, text_color=volCol, bgcolor=color.new(color.black, 20))
table.cell(dash, 0, 19, "Risk Score", text_color=color.white, bgcolor=color.new(color.black, 20))

table.cell(dash, 1, 19, na(riskScore) ? "na" : str.tostring(riskScore, "#") + " / 100", text_color=riskCol, bgcolor=color.new(color.black, 20))
table.cell(dash, 0, 20, "Risk State", text_color=color.white, bgcolor=color.new(color.black, 20))
table.cell(dash, 1, 20, riskState, text_color=riskCol, bgcolor=color.new(color.black, 20))
table.cell(dash, 0, 21, "Risk Direction", text_color=color.white, bgcolor=color.new(color.gray, 80))
table.cell(dash, 1, 21, riskDirection, text_color=riskCol, bgcolor=color.new(color.gray, 80))
table.cell(dash, 0, 22, "Risk Reason", text_color=color.white, bgcolor=color.new(color.black, 20))
table.cell(dash, 1, 22, riskReason, text_color=riskCol, bgcolor=color.new(color.black, 20))
table.cell(dash, 0, 23, "Risk Engine", text_color=color.white, bgcolor=color.new(color.gray, 80))
table.cell(dash, 1, 23, riskEngineVersion + " diagnostic", text_color=color.white, bgcolor=color.new(color.gray, 80))
table.cell(dash, 0, 24, "Vol Risk State", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 1, 24, riskVolState, text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 0, 25, "Ext Risk State", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 1, 25, riskExtState, text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 0, 26, "Struct Risk State", text_color=color.white, bgcolor=color.new(color.gray, 85))

table.cell(dash, 1, 26, riskStructState, text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 0, 27, "Conflict Risk State", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 1, 27, riskConflictState, text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 0, 28, "Vol Risk Contrib", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 1, 28, f_fmt(riskVolRaw) + " / 35", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 0, 29, "Ext Risk Contrib", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 1, 29, f_fmt(riskExtRaw) + " / 30", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 0, 30, "Struct Risk Contrib", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 1, 30, f_fmt(riskStructRaw) + " / 20", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 0, 31, "Conflict Risk Contrib", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 1, 31, f_fmt(riskConflictRaw) + " / 15", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 0, 32, "Smoothed Risk Score", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 1, 32, f_fmt(riskSmoothedRaw), text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 0, 33, "Price Score", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 1, 33, str.tostring(priceScore, "#") + " / 20", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 0, 34, "Slow Align", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 1, 34, str.tostring(slowAlignScore, "#") + " / 30", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 0, 35, "Slope Score", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 1, 35, str.tostring(slopeScore, "#") + " / 20", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 0, 36, "RSI/MACD/ADX", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 1, 36, str.tostring(rsiScore, "#") + "/" + str.tostring(macdScore, "#") + "/" + str.tostring(adxScore, "#"), text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 0, 37, "Vol Engine", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 1, 37, volEngineVersion + " diagnostic", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 0, 38, "Trend State", text_color=color.white, bgcolor=color.new(color.black, 20))
table.cell(dash, 1, 38, trendState, text_color=trendCol, bgcolor=color.new(color.black, 20))
table.cell(dash, 0, 39, "Trend Strength", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 1, 39, na(trendStrength) ? "na" : str.tostring(trendStrength, "#.##"), text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 0, 40, "Trend Age", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 1, 40, na(trendAge) ? "na" : str.tostring(trendAge, "#"), text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 0, 41, "Trend Direction", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 1, 41, trendState, text_color=trendCol, bgcolor=color.new(color.gray, 85))
table.cell(dash, 0, 42, "Trend Engine", text_color=color.white, bgcolor=color.new(color.gray, 85))
table.cell(dash, 1, 42, trendEngineVersion + " diagnostic", text_color=color.white, bgcolor=color.new(color.gray, 85))

// ─────────────────────────────────────────────────────────────────────────────
// RESEARCH MODE
// ─────────────────────────────────────────────────────────────────────────────
var table research = table.new(position.bottom_right, 1, 1, border_width=1)
if barstate.islast
table.clear(research, 0, 0, 0, 0)
if showResearch
researchText =
"ATE_RESEARCH_LOG\n" +
"ATEVersion: v2.2\n" +
"Symbol: " + syminfo.ticker + "\n" +
"Timeframe: " + timeframe.period + "\n" +
"Profile: " + profile + "\n" +
"TrendScore: " + str.tostring(trendScore, "#") + "\n" +
"StructureScore: " + str.tostring(structureScore, "#") + "\n" +
"MomentumScore: " + str.tostring(momentumScore, "#") + "\n" +
"ConfidenceScore: " + str.tostring(confidenceScore, "#") + "\n" +
"MarketState: " + marketState + "\n" +
"StructureState: " + structureState + "\n" +
"MomentumState: " + momentumState + "\n" +
"VolatilityEngineVersion: " + volEngineVersion + "\n" +
"VolatilityScore: " + f_fmt(volScore) + "\n" +
"VolatilityState: " + volState + "\n" +
"VolatilityDirection: " + volDirection + "\n" +
"VolatilityReason: " + volReason + "\n" +
"ATRPercent: " + f_fmt(volAtrPercent) + "\n" +
"ATRRatio: " + f_fmt(volAtrRatio) + "\n" +
"BBWidthRatio: " + f_fmt(volBbWidthRatio) + "\n" +
"CombinedVolRatio: " + f_fmt(volCombinedRatio) + "\n" +
"VolSlope: " + f_fmt(volSlope) + "\n" +
"ShockFlag: " + str.tostring(volShockFlag) + "\n" +
"RiskEngineVersion: " + riskEngineVersion + "\n" +
"RiskScore: " + f_fmt(riskScore) + "\n" +
"RiskState: " + riskState + "\n" +
"RiskDirection: " + riskDirection + "\n" +
"RiskReason: " + riskReason + "\n" +
"VolRiskContribution: " + f_fmt(riskVolRaw) + "\n" +
"ExtRiskContribution: " + f_fmt(riskExtRaw) + "\n" +
"StructRiskContribution: " + f_fmt(riskStructRaw) + "\n" +
"ConflictRiskContribution: " + f_fmt(riskConflictRaw) + "\n" +
"VolRiskState: " + riskVolState + "\n" +
"ExtRiskState: " + riskExtState + "\n" +
"StructRiskState: " + riskStructState + "\n" +
"ConflictRiskState: " + riskConflictState + "\n" +
"BarRangeATR: " + f_fmt(riskDiagExtBarRangeAtr) + "\n" +
"LastSwingATR: " + f_fmt(riskDiagStructLastSwingAtr) + "\n" +
"RiskInsufficientData: " + str.tostring(riskDiagInsufficientData) + "\n" +
"TrendEngineVersion: " + trendEngineVersion + "\n" +
"TrendState: " + trendState + "\n" +
"TrendStrength: " + (na(trendStrength) ? "na" : str.tostring(trendStrength, "#.##")) + "\n" +
"TrendAge: " + (na(trendAge) ? "na" : str.tostring(trendAge, "#")) + "\n" +
"TrendDiagEmaSlope: " + (na(trendDiagEmaSlope) ? "na" : str.tostring(trendDiagEmaSlope, "#.######")) + "\n" +
"TrendDiagAgreement: " + (na(trendDiagAgreement) ? "na" : str.tostring(trendDiagAgreement, "#.##")) + "\n" +
"TrendDiagHigherHigh: " + str.tostring(trendDiagHigherHigh) + "\n" +
"TrendDiagHigherLow: " + str.tostring(trendDiagHigherLow) + "\n" +
"TrendDiagLowerHigh: " + str.tostring(trendDiagLowerHigh) + "\n" +
"TrendDiagLowerLow: " + str.tostring(trendDiagLowerLow) + "\n" +
"TrendDiagStateConfirmBars: " + str.tostring(trendDiagStateConfirmBars) + "\n" +
"TrendDiagInsufficientData: " + str.tostring(trendDiagInsufficientData) + "\n" +
"Close: " + str.tostring(close, "#.##")
table.cell(research, 0, 0, researchText, text_color=color.white, bgcolor=color.new(color.black, 10), text_size=size.small)
// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// No RiskEngine alerts in ATE v2.2.
// Existing ATE alert behaviour preserved.
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(goldenCross, "ATE Golden Cross", "Austin Trading Engine: Golden Cross detected")
alertcondition(deathCross, "ATE Death Cross", "Austin Trading Engine: Death Cross detected")
alertcondition(strongBullStart, "ATE Strong Bull", "Austin Trading Engine: Strong Bull market state started")
alertcondition(strongBearStart, "ATE Strong Bear", "Austin Trading Engine: Strong Bear market state started")
alertcondition(bosBull, "ATE Bullish BOS", "Austin Trading Engine: Bullish Break of Structure")
alertcondition(bosBear, "ATE Bearish BOS", "Austin Trading Engine: Bearish Break of Structure")
alertcondition(momentumBull, "ATE Momentum Bullish", "Austin Trading Engine: Momentum became bullish")
alertcondition(momentumBear, "ATE Momentum Bearish", "Austin Trading Engine: Momentum became bearish")
alertcondition(confidenceBull, "ATE High Confidence Bull", "Austin Trading Engine: Confidence crossed bullish threshold")
alertcondition(confidenceBear, "ATE Low Confidence Bear", "Austin Trading Engine: Confidence crossed bearish threshold")